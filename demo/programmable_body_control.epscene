    "scene_settings": {
        "programs": [
            {
                "bindings": {
                    "body": "1"
                },
                "enabled": true,
                "name": "定时拉力",
                "parameters": {
                    "force": 2
                },
                "period": 0.01,
                "source": "/** @brief 一秒开始施力，三秒停止。 */\nvoid on_step(void)\n{\n    Entity body = scene_entity(\"body\");\n    if (simulation_time() >= 1 && !state_bool(\"started\")) {\n        entity_set_force(body, vector3(parameter_number(\"force\"), 0, 0));\n        state_set_bool(\"started\", true);\n    }\n    if (simulation_time() >= 3 && !state_bool(\"ended\")) {\n        entity_set_force(body, vector3(0, 0, 0));\n        state_set_bool(\"ended\", true);\n    }\n}",
                "version": 1
            },
            {
                "bindings": {
                    "body": "1"
                },
                "enabled": true,
                "name": "动态替身",
                "period": 0.01,
                "source": "/** @brief 创建替身并在后续时刻销毁原物体。 */\nvoid on_step(void)\n{\n    if (simulation_time() >= 3.2 && !state_bool(\"created\")) {\n        Entity replacement = scene_spawn(scene_template(\"body\"), vector3(0, 1, 0));\n        entity_set_velocity(replacement, vector3(1, 0, 0));\n        state_set_entity(\"replacement\", replacement);\n        state_set_bool(\"created\", true);\n    }\n    if (simulation_time() >= 4 && !state_bool(\"removed\")) {\n        entity_destroy(scene_entity(\"body\"));\n        state_set_bool(\"removed\", true);\n    }\n}",
                "version": 1
            }
        ]
    },
