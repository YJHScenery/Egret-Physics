    </qresource>
    <qresource prefix="/components">
        <file>components/theme/DeepBlueTheme.qml</file>
        <file>components/basic/EgretPushButton.qml</file>
        <file>components/basic/EgretSeparator.qml</file>
        <file>components/EgretMenuBar.qml</file>
        <file>components/GlassPanel.qml</file>
        <file>components/LeftNavPanel.qml</file>
        <file>components/MetricCard.qml</file>
        <file>components/Coordinate.qml</file>
        <file>components/AboutDialog.qml</file>
        <file>components/FloatField.qml</file>
    </qresource>
    <qresource prefix="/units">
        <file>units/SimulatorUnit.qml</file>
        <file>units/EditorUnit.qml</file>
    </qresource>
    <qresource prefix="/shaders">
        <file>shaders/simple_line.vert</file>
