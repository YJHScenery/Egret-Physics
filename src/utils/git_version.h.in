#ifndef GIT_VERSION_H
#define GIT_VERSION_H

// Git信息
#define GIT_COMMIT_HASH     "@GIT_COMMIT_HASH@"
#define GIT_COMMIT_SHORT    "@GIT_COMMIT_SHORT@"
#define GIT_BRANCH          "@GIT_BRANCH@"
#define GIT_TAG             "@GIT_TAG@"
#define BUILD_TIME          "@BUILD_TIME@"

// 便捷的完整版本字符串
#define GIT_VERSION_FULL    GIT_COMMIT_SHORT "@" GIT_BRANCH
#define PREFIX_GIT_VERSION_FULL "." GIT_VERSION_FULL
#define GIT_VERSION_DETAIL  "Commit: " GIT_COMMIT_SHORT "\nBranch: " GIT_BRANCH "\nBuild: " BUILD_TIME

#endif